syntax = "v1"

info (
	title:   "Arena Teaching Demo API"
	desc:    "Side-by-side teaching dialogue comparison system"
	author:  "ivansnow02"
	version: "v1"
)

type ModelConfig {
	Name    string `json:"name"`
	ApiKey  string `json:"api_key"`
	BaseUrl string `json:"base_url"`
}

type ChatMessage {
	Role    string `json:"role"`
	Content string `json:"content"`
}

type ChatStreamReq {
	Model        ModelConfig   `json:"model"`
	SystemPrompt string        `json:"system_prompt,optional"`
	Messages     []ChatMessage `json:"messages"`
	Temperature  float64       `json:"temperature,optional,default=0.8"`
	MaxTokens    int           `json:"max_tokens,optional,default=2048"`
}

type PresetPrompt {
	Id          string `json:"id"`
	Name        string `json:"name"`
	Description string `json:"description"`
	Content     string `json:"content"`
}

type PresetsResp {
	Presets []PresetPrompt `json:"presets"`
}

@server (
	prefix: /api
)
service arena-api {
	@doc "SSE streaming chat"
	@handler ChatStream
	post /chat/stream (ChatStreamReq)

	@doc "Get preset prompts"
	@handler GetPresets
	get /presets returns (PresetsResp)
}

