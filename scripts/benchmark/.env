# 复制本文件为 .env 并按需填写（此仓库默认不会提交真实密钥）
MULTI_DIALOGUE_INPUT_FILE=data/interdisciplinary_topic.json

# ===== multi_dialogue.py（对话生成） =====
# 输出目录（将生成 multi_dialogue_topic_<topic_id>.json）
OUTPUT_DIR=/root/autodl-fs/output/dialog/dpo_model_1k_3can_rewritten_opt

# ===== 教师配置（LM Studio 本地模型） =====
TEACHER_BASE_URL=http://0.0.0.0:8000/v1
TEACHER_API_KEY=not-needed
TEACHER_MODEL=teacher_model

# ===== 学生配置（远程 API） =====
STUDENT_OPENAI_API_KEY=not-needed
STUDENT_OPENAI_BASE_URL=http://0.0.0.0:8000/v1
STUDENT_MODEL=unsloth/Qwen3-14B-unsloth-bnb-4bit
# 如果学生服务不是标准路径，可直接填完整地址，例如：https://host/v1/chat/completions

# ===== annotation.py（LM Studio 标注） =====
# LM Studio API 地址（确保 LM Studio 运行在此地址）
LM_STUDIO_API_URL=http://198.18.0.1:1234/v1
# LM Studio 模型名
ANNOTATION_MODELS=qwen/qwen3-4b-2507:2,qwen/qwen3-4b-2507
# 标注输入目录
ANNOTATION_INPUT_DIR=/home/ioyuk1nya/Graduation_Project/SID_benchmark/output/dialog/dpo_model_1k_3can_rewritten_opt
# 标注输出目录
ANNOTATION_OUTPUT_DIR=/home/ioyuk1nya/Graduation_Project/SID_benchmark/output/annotations/dpo_model_1k_3can_rewritten_opt
MAX_WORKERS=4

# ===== subjective_eval.py（主观评测） =====
# # 评测读取/输出的根目录（通常是你的实验目录）
# BASE_PATH=/home/ioyuk1nya/Graduation_Project/SID_benchmark
# 评测API地址（OpenAI 兼容）
JUDGE_API_URL=http://198.18.0.1:1234/v1/chat/completions
# 评测模型名
JUDGE_MODEL=qwen/qwen3-4b-2507
# 评测数据集目录（默认：PROJECT_ROOT/datasets/multi_dialogue）
SUBJECTIVE_DATASET_DIR=/home/ioyuk1nya/Graduation_Project/SID_benchmark/output/dialog/qwen-4b
# # 评测报告输出目录（默认：PROJECT_ROOT/SID_benchmark/output/subjective/<model_prefix>）
# SUBJECTIVE_REPORT_DIR=
# # 评测文件匹配模式（默认：dataset_dir/**/*_topic_*.json）
# SUBJECTIVE_FILE_PATTERN=
